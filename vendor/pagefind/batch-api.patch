+                if let Ok(bytes) = serde_json::to_vec(&data) { cache.put(&url, &html, &bytes); }
+                Ok(data)
+            }).collect()
+        });
+        self.fossicked_pages = results.into_iter().collect::<Result<Vec<_>>>()?;
+        Ok(())
+    }
