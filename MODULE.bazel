module(
    name = "trail",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [],
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "prettier",
    build_file_content = """
exports_files(["index.mjs"])
filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])
""",
    integrity = "sha512-OpN0zzVdiaiAhxpuuj5efpIS4sY9j7bY6uR5mnj5yPzGkdkjNKSJeUThPb60Jw29QuAZgA4o+/iB49kFiaBX6g==",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/prettier/-/prettier-3.9.6.tgz"],
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "buildifier",
    executable = True,
    sha256 = "31b6a8aa1e5c746696788f428729701770ad91925873d8256cb885c60e12c77e",
    urls = ["https://github.com/bazel-contrib/buildtools/releases/download/v10.1.0/buildifier-linux-amd64"],
)
